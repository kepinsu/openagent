{
  "$schema": "https://opencode.ai/config.json",
  // Local profile: optimized for LM Studio/self-hosted models and high autonomy.
  "subagent_depth": 10,
  "openagent_mode": {
    "name": "local",
    "context_strategy": "broad",
    "share_raw_findings": true,
    "max_files_per_agent": 30,
    "max_parallel_agents": 4,
    "max_retries_per_task": 3,
    "external_scout": "auto"
  },
  "provider": {
    "lmstudio": {
      "name": "LM Studio",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://100.114.213.120:9090/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "qwen": {
          "name": "qwen/qwen3.6-35b-a3b",
          "limit": {
            "context": 180000,
            "output": 10000
          },
          "params": {
            "temperature": 0.2,
            "repeatPenalty": 1.3
          }
        }
      }
    }
  },
  "model": "lmstudio/qwen"
}
