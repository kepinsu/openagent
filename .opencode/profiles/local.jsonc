{
  "$schema": "https://opencode.ai/config.json",
  // Local profile: bounded for self-hosted models with a ~70k-token window.
  "subagent_depth": 3,
  "openagent_mode": {
    "name": "local",
    "context_strategy": "compact",
    "share_raw_findings": false,
    "max_files_per_agent": 12,
    "max_context_tokens_per_agent": 60000,
    "max_parallel_agents": 2,
    "max_retries_per_task": 1,
    "external_scout": "on_demand",
    "stop_on_repeated_failure": true
  },
  "provider": {
    "omlx": {
      "name": "omlx",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:9090/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "Qwen3.6-35B-A3B-MLX-4bit": {
          "name": "qwen MoE 4bit",
          "limit": {
            "context": 230000,
            "output": 32768
          },
          "params": {
            "repeatPenalty": 1.3
          },
          "variants": {
            "thinking": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "xhigh"
              }
            },
            "medium-thinking": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "medium"
              }
            },
            "fast": {
              "chat_template_kwargs": {
                "enable_thinking": false,
                "preserve_thinking": false,
                "reasoning_effort": "low"
              }
            }
          }
        },
        "Qwen3.8-27B": {
          "name": "Qwen Dense 4bit",
          "limit": {
            "context": 235520,
            "output": 32768
          },
          "variants": {
            "high": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "xhigh"
              }
            },
            "medium": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "medium"
              }
            },
            "low": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "low"
              }
            },
            "fast": {
              "chat_template_kwargs": {
                "enable_thinking": false,
                "preserve_thinking": false,
                "reasoning_effort": "low"
              }
            }
          }
        }
      }
    }
  },
  "model": "omlx/Qwen3.6-35B-A3B-MLX-4bit"
}
