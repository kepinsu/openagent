{
  "$schema": "https://opencode.ai/config.json",
  // Local profile: bounded for self-hosted models with a ~70k-token window.
  "subagent_depth": 3,
  "openagent_mode": {
    "name": "local",
    "context_strategy": "compact",
    "share_raw_findings": false,
    "max_files_per_agent": 12,
    "max_context_tokens_per_agent": 60000,
    "max_parallel_agents": 2,
    "max_retries_per_task": 1,
    "external_scout": "on_demand",
    "stop_on_repeated_failure": true
  },
  "provider": {
    "lmstudio": {
      "name": "LM Studio",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://100.114.213.120:9090/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "qwen": {
          "name": "qwen/qwen3.6-35b-a3b",
          "limit": {
            "context": 180000,
            "output": 10000
          },
          "params": {
            "temperature": 0.2,
            "repeatPenalty": 1.3
          }
        }
      }
    }
  },
  "model": "lmstudio/qwen"
}
